{
  "detector": {
    "name": "ctd",
    "detection_size": 2048,
    "text_threshold": 0.5,
    "box_threshold": 0.65,
    "max_candidates": 100,
    "unclip_ratio": 2.6,
    "use_bubble_prefilter": false,
    "bubble_prefilter_confidence": 0.3,
    "secondary_detectors": []
  },
  "ocr": {
    "ocr": "48px_ctc",
    "secondary_ocr": "48px",
    "tertiary_ocr": "none",
    "use_mocr_merge": true,
    "ignore_bubble": 0
  },
  "render": {
    "renderer": "manga2eng",
    "alignment": "auto",
    "uppercase": false,
    "lowercase": false,
    "no_hyphenation": true,
    "gimp_font": "WildWords",
    "font_path": "./fonts/WildWords.ttf",
    "auto_font_size": true,
    "font_size_offset": -2,
    "min_font_size": 10,
    "max_font_size": 28,
    "max_text_width_ratio": 0.90
  },
  "upscale": {
    "upscaler": "esrgan"
  },
  "inpainter": {
    "inpainter": "lama_mpe",
    "inpainting_size": 2048,
    "inpainting_precision": "fp32"
  },
  "translator": {
    "translator": "openai",
    "model": "gpt-4.1-nano",
    "source_lang": "auto",
    "target_lang": "HUN",
    "gpt_config": "./MangaStudio_Data/gpt_configs/my_cool_prompt.yaml",
    "enable_post_translation_check": false
  },
  "kernel_size": 3,
  "mask_dilation_offset": 20,
  "mask_fill_mode": "character",
  "models_dir": "./models"
}
